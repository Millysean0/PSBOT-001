# =============================================================================
# PSBOT-001: Environment Configuration
# =============================================================================
# Salin file ini menjadi .env lalu sesuaikan nilai variabel di bawah:
#   cp .env.example .env

# [Wajib] Token Bot Telegram dari @BotFather di Telegram
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# [Wajib] Kunci Enkripsi AES Fernet untuk mengamankan data pengguna di database
# Generate kunci baru dengan perintah:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=YOUR_GENERATED_FERNET_KEY_HERE

# [Opsional] Telegram User ID pemilik/admin bot (hanya angka)
# Dapatkan ID akun Telegram Anda melalui bot @userinfobot
ADMIN_USER_ID=

# [Opsional] Nomor WhatsApp untuk integrasi bot (format internasional tanpa +, contoh: 6281234567890)
# Kosongkan jika ingin login menggunakan QR Code di terminal
WA_PHONE_NUMBER=

# [Opsional] Konfigurasi Bot Discord
# Dapatkan bot token dari Discord Developer Portal: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
# ID Channel Discord default untuk broadcast notifikasi tugas/presensi/materi
DISCORD_CHANNEL_ID=
# Aktifkan integrasi bot Discord (true / false)
ENABLE_DISCORD=true
